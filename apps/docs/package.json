{
  "name": "@ajnacloud/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "pnpm --filter @ajnacloud/ui build && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@ajnacloud/ui": "workspace:*",
    "fumadocs-core": "^16.15.3",
    "fumadocs-mdx": "^15.4.6",
    "fumadocs-typescript": "^5.2.6",
    "fumadocs-ui": "^16.15.3",
    "lucide-react": "^0.468.0",
    "next": "^16.3.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "@internationalized/date": "^3.11.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.3"
  }
}
