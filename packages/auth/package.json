{
  "name": "@ajnacloud/auth",
  "version": "0.1.0-beta.0",
  "description": "The Ajna platform sign-in: SRP against Amazon Cognito in the browser and the sign-in screens, built from @ajnacloud/ui.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajnacloud-ksj/ui.git",
    "directory": "packages/auth"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "pnpm build && node scripts/test-package.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1167.0"
  },
  "peerDependencies": {
    "@ajnacloud/ui": "^0.1.0-beta.9",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@ajnacloud/ui": "workspace:*",
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "amazon-cognito-identity-js": "6.3.22",
    "jsdom": "^29.1.1",
    "publint": "^0.3.25",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsdown": "^0.23.4",
    "typescript": "5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
